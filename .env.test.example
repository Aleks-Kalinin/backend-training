# Copy this file to .env.test and set the password for your local test-only role.
PORT=3007
NODE_ENV=test
COOKIE_SECRET=test-only-cookie-secret
JWT_SECRET=test-only-access-token-secret
JWT_REFRESH_SECRET=test-only-refresh-token-secret

HEALTH_CHECK_ENABLED=false
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=100

# This must be a dedicated local database, never your development or production DB.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=backend_training_test
POSTGRES_PASSWORD=replace-with-local-test-role-password
POSTGRES_DB=backend_training_test
POSTGRES_SYNCHRONIZE=true
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=false

# These placeholders satisfy mail transport setup; e2e tests must not send mail.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=test
SMTP_PASSWORD=test
SMTP_FROM=test@example.invalid
